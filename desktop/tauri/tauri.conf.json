{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Армспорт",
  "mainBinaryName": "armsport",
  "version": "1.0.0",
  "identifier": "dev.poehali.armsport",
  "build": {
    "frontendDist": "../../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Армспорт — турнир по армрестлингу",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "languages": ["Russian"], "installMode": "currentUser" },
      "wix": { "language": "ru-RU" }
    }
  }
}
