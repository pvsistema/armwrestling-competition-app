{
 "tests": [
  {
   "name": "Сервис отвечает",
   "method": "GET",
   "path": "/",
   "expectedStatus": 200,
   "expectedBody": {
    "service": "license"
   },
   "bodyMatcher": "partial"
  },
  {
   "name": "Несуществующий ключ",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "activate",
    "key": "AAAA-BBBB-CCCC-DDDD",
    "device": "test-device-123"
   },
   "expectedStatus": 200,
   "expectedBody": {
    "ok": false,
    "reason": "not_found"
   },
   "bodyMatcher": "partial"
  },
  {
   "name": "Админка без пароля",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "list"
   },
   "expectedStatus": 401
  },
  {
   "name": "Открытый ключ подписи",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "pubkey"
   },
   "expectedStatus": 200
  },
  {
   "name": "Последняя версия программы",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "latest"
   },
   "expectedStatus": 200
  },
  {
   "name": "Публикация без пароля",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "rel_list"
   },
   "expectedStatus": 401
  },
  {
   "name": "Ссылка не из хранилища",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "rel_create"
   },
   "expectedStatus": 401
  }
 ]
}